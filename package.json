{
  "name": "globalise-research-portal",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "pnpm --filter @globalise/app dev",
    "build:app": "pnpm --filter @globalise/app build",
    "build": "pnpm test && pnpm typecheck && pnpm lint && pnpm build:app",
    "serve": "pnpm --filter @globalise/app serve",
    "diplomatic:demo": "pnpm --filter @globalise/diplomatic demo",
    "diplomatic:screenshot": "pnpm --filter @globalise/diplomatic screenshot",
    "preview": "pnpm --filter @globalise/app build && pnpm --filter @globalise/app preview",
    "typecheck": "tsc -b --clean && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@types/lodash": "^4.17.25",
    "lodash": "^4.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.103.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/openseadragon": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "msw": {
    "workerDirectory": [
      "packages/app/public"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
    }
  }
}
